# Green API (from wa-setup)
GREEN_API_URL=https://XXXX.api.greenapi.com
GREEN_API_INSTANCE=XXXXXXXXXX
GREEN_API_TOKEN=your-green-api-token

# LLM "brain" (from wa-build)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-...

# Voice-message transcription (from wa-build)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Bot config
BOT_OWNER_PHONE=9725XXXXXXXX
BOT_TIMEZONE=Asia/Jerusalem
DATABASE_PATH=data/conversations.db
MAX_HISTORY=30

# Google OAuth (added later by wa-connect)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
